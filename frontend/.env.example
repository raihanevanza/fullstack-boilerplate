# Base URL of the backend API (see ../docs/API.md)
VITE_API_BASE_URL=http://localhost:8080/api

# Name shown in the sidebar, login page and browser tab
VITE_APP_NAME=Boilerplate

# Display currency (ISO 4217). Prices from the API are plain numbers.
# VITE_CURRENCY=IDR

# Demo-account cards on the login page. Defaults to shown in `npm run dev` and demo builds,
# hidden in production builds. Set to true/false to force.
# VITE_SHOW_DEMO_ACCOUNTS=

# Demo mode: the API is answered in the browser (src/demo), no backend needed.
# Normally enabled through `npm run dev:demo` / `npm run build:demo` (.env.demo).
# VITE_DEMO_MODE=false
