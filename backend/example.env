# Copy to .env (git-ignored). Real environment variables override this file.

PORT=8080
# DEVELOPMENT | STAGING | PRODUCTION. Swagger is served unless PRODUCTION.
STAGE=DEVELOPMENT
# Also used as the JWT issuer (iss).
SERVICE_NAME=boilerplate-backend

# Allowed browser origins, comma separated. Empty allows every origin.
# In DEVELOPMENT any http://localhost:<port> is allowed as well.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Reverse proxies whose X-Forwarded-For header is trusted (comma separated IPs/CIDRs).
TRUSTED_PROXIES=

# sqlserver://user:password@host:port?database=AppDb&encrypt=disable
# URL-encode special characters in the password (e.g. # -> %23, @ -> %40).
SQL_SERVER_URI=sqlserver://sa:change-me@localhost:1433?database=AppDb&encrypt=disable

# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (Go duration).
JWT_TTL=8h
